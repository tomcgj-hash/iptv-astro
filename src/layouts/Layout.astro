---
// Layout.astro — shared site layout
// Conventions: Tailwind CDN, Font Awesome, jQuery, header/footer loaded via fetch
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  schema?: object; // JSON-LD schema object
  breadcrumbs?: { name: string; url: string }[]; // breadcrumb trail
}

const {
  title = 'Professional Digital TV Headend Equipment Manufacturer | FMUSER',
  description = 'FMUSER supplies the FMUSER FUQ digital TV headend line: encoders, encoder-modulators, modulators, IP gateways, IRDs, multiplexers, EPG and IPTV server software, DVB-T and FM transmitters. 191 models, each with its published datasheet.',
  schema,
  breadcrumbs,
} = Astro.props;

// default Organization schema
const siteSchema = schema || {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'FMUSER',
  url: Astro.site?.toString() || 'https://www.iptv-demo.example.com',
  description,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined} />

    <!-- Typeface: Inter (design system font; falls back to system fonts if the CDN is unreachable) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />

    <!-- Tailwind CSS (CDN) -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              primary: '#2563eb',
              ink: '#1e293b',
              sand: '#f8fafc',
            },
          },
        },
      };
    </script>

    <!-- Font Awesome icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Custom styles -->
    <link rel="stylesheet" href="/css/style.css" />

    <!-- SEO: JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)}></script>

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined} />
    <meta property="og:image" content="/images/logo.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/images/logo.svg" />

    <!-- Pagefind custom meta (search result thumbnails) -->
    {
      Astro.props.image && (
        <meta name="pagefind-meta-image" content={Astro.props.image} />
      )
    }
    {
      Astro.props.category && (
        <meta name="pagefind-meta-category" content={Astro.props.category} />
      )
    }
  </head>
  <body class="flex min-h-screen flex-col text-slate-900 antialiased">
    <!-- Header placeholder (filled by js/main.js from header.html) -->
    <div id="header"></div>

    <!-- Breadcrumbs (optional) -->
    {
      breadcrumbs && breadcrumbs.length > 0 && (
        <nav class="bg-slate-50 border-b border-slate-100" aria-label="Breadcrumb">
          <div class="container mx-auto max-w-7xl px-4 py-3">
            <ol class="breadcrumb">
              <li><a href="/"><i class="fas fa-home mr-1"></i>Home</a></li>
              {breadcrumbs.map((crumb, i) => (
                <>
                  <li class="sep"><i class="fas fa-chevron-right text-xs"></i></li>
                  {i === breadcrumbs.length - 1 ? (
                    <li aria-current="page" class="text-slate-500">{crumb.name}</li>
                  ) : (
                    <li><a href={crumb.url}>{crumb.name}</a></li>
                  )}
                </>
              ))}
            </ol>
          </div>
        </nav>
      )
    }

    <!-- Main content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer placeholder (filled by js/main.js from footer.html) -->
    <div id="footer"></div>

    <!-- jQuery (local file) -->
    <script is:inline src="/js/jquery-2.2.4.min.js"></script>
    <!-- Shared site script -->
    <script is:inline src="/js/main.js"></script>
  </body>
</html>
