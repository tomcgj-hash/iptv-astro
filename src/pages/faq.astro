---
import Layout from '../layouts/Layout.astro';

const faqs = [
  {
    q: 'Are you a manufacturer or a trading company?',
    a: 'We are a manufacturer. All our equipment is designed, developed and produced in our own ISO 9001 certified factory in Guangzhou, China. You buy directly from the source — no middlemen.',
  },
  {
    q: 'What is the minimum order quantity (MOQ)?',
    a: 'MOQ is 1 unit for most standard products. For OEM/ODM customization (custom branding, specifications or packaging), a minimum order applies — contact us for details.',
  },
  {
    q: 'How fast will I receive a quotation?',
    a: 'Standard quotations are sent within 24 hours. For complex projects with custom requirements, our engineers may need 2–3 days to prepare a full proposal.',
  },
  {
    q: 'What payment methods do you accept?',
    a: 'We accept bank transfer (T/T), PayPal and major credit cards for sample orders, and T/T or Letter of Credit for bulk orders. Full payment terms are provided with each quotation.',
  },
  {
    q: 'How long does production and delivery take?',
    a: 'Standard products ship within 3–7 days. Bulk orders typically take 15–30 days depending on quantity. We offer both air freight (3–7 days) and sea freight (20–40 days) worldwide.',
  },
  {
    q: 'Do you provide OEM / ODM services?',
    a: 'Yes. We offer full OEM/ODM services including custom branding, custom specifications, software customization and custom packaging for your product line.',
  },
  {
    q: 'What warranty do you provide?',
    a: 'All products come with a standard 12-month warranty covering manufacturing defects. Extended warranties and spare parts are available on request.',
  },
  {
    q: 'Do you provide technical support after purchase?',
    a: 'Yes — every order includes lifetime technical support. Our engineers provide remote diagnostics, configuration assistance and on-site support where required.',
  },
  {
    q: 'Can I get a sample before placing a bulk order?',
    a: 'Absolutely. Sample orders are welcome and we recommend testing equipment with your own system before scaling up.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  url: 'https://www.iptv-demo.example.com/faq/',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbs = [{ name: 'FAQ', url: '/faq/' }];
---

<Layout
  title="FAQ — Manufacturing, MOQ, Shipping & OEM Questions | IPTVStream Broadcast"
  description="Answers to common questions about our broadcast equipment factory: MOQ, quotation time, payment, shipping, OEM/ODM services, warranty and technical support."
  schema={faqSchema}
  breadcrumbs={breadcrumbs}
>
  <!-- ===== 页面标题 ===== -->
  <section class="relative bg-[#f5f5f7] py-16 lg:py-24 text-center border-b border-[#e8e8ed] overflow-hidden" aria-label="FAQ overview">
    <div class="relative container mx-auto max-w-3xl px-4">
      <p class="text-[#0071e3] text-sm font-semibold tracking-[0.2em] uppercase mb-4">FAQ</p>
      <h1 class="text-4xl lg:text-6xl font-bold text-[#1d1d1f] tracking-tight mb-5">Frequently Asked <span class="gradient-text">Questions</span></h1>
      <p class="text-[#6e6e73] text-lg">Everything you need to know about ordering from our factory.</p>
    </div>
  </section>

  <!-- ===== FAQ 列表 ===== -->
  <section class="py-16 lg:py-24 bg-white" aria-label="Frequently asked questions">
    <div class="container mx-auto max-w-4xl px-4">
      <div class="space-y-4">
        {
          faqs.map((f, i) => (
            <details class="group bg-[#f5f5f7] rounded-2xl border border-[#e8e8ed] overflow-hidden" open={i === 0}>
              <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none font-semibold text-[#1d1d1f] hover:text-[#0071e3] transition-colors">
                <span class="flex items-center gap-4"><span class="text-[#0071e3] font-bold text-sm">{String(i + 1).padStart(2, '0')}</span>{f.q}</span>
                <i class="fas fa-chevron-down text-xs text-[#86868b] transition-transform group-open:rotate-180"></i>
              </summary>
              <div class="px-6 pb-5 pl-16 text-[#6e6e73] leading-relaxed">{f.a}</div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="py-16 lg:py-24 bg-[#f5f5f7]" aria-label="Ask a question">
    <div class="container mx-auto max-w-4xl px-4 text-center reveal">
      <h2 class="text-3xl lg:text-4xl font-bold text-[#1d1d1f] tracking-tight mb-4">Still Have <span class="gradient-text">Questions?</span></h2>
      <p class="text-[#6e6e73] text-lg mb-8">Our team responds to all inquiries within 24 hours.</p>
      <a href="/contact/" class="btn-primary text-base px-10 py-4">
        <i class="fas fa-comments"></i> Ask Us Anything
      </a>
    </div>
  </section>
</Layout>
