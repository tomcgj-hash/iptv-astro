---
import Layout from '../layouts/Layout.astro';

const faqs = [
  {
    q: 'Are you a manufacturer or a trading company?',
    a: 'We are an export desk supplying the FMUSER FUQ headend line: the equipment is produced by the manufacturer, and we specify, quote, ship and support it for your project. That is why every model page on this site carries the manufacturer datasheet instead of rewritten sales copy.',
  },
  {
    q: 'What is the minimum order quantity (MOQ)?',
    a: 'There is no blanket MOQ on this site — it is quoted per model. Standard units are normally available singly; custom branding, software configuration or custom packaging needs a minimum that we confirm with your quotation.',
  },
  {
    q: 'How fast will I receive a quotation?',
    a: 'Quotations are prepared per enquiry: we check the model against its datasheet and the factory schedule first. A single-model enquiry is answered quickly; a full channel plan takes longer. Tell us your deadline and we will confirm what is realistic.',
  },
  {
    q: 'What payment methods do you accept?',
    a: 'Payment terms are set out in the written quotation. Bank transfer is the standard instrument; other options are agreed per order and per quantity.',
  },
  {
    q: 'How long does production and delivery take?',
    a: 'Lead time depends on the model and the position in the factory schedule, and is confirmed in the quotation. Air and sea freight are both arranged; transit time depends on the destination.',
  },
  {
    q: 'Do you provide OEM / ODM services?',
    a: 'Custom branding, packaging and software configuration are possible on this line. Minimum quantities and lead time are confirmed per model before you commit to a build.',
  },
  {
    q: 'What warranty do you provide?',
    a: 'Warranty and service terms are stated in the quotation for your order, together with spare-part availability, so the terms are on the record before the order is placed. We do not publish a blanket warranty period on this site.',
  },
  {
    q: 'Do you provide technical support after purchase?',
    a: 'Yes — configuration help, firmware and datasheet questions, and escalation to the factory when a unit needs service. The scope is confirmed with your order.',
  },
  {
    q: 'Can I get a sample before placing a bulk order?',
    a: 'Yes. Testing the unit inside your own system before scaling up is the sensible way to buy this kind of equipment.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  url: 'https://www.iptv-demo.example.com/faq/',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbs = [{ name: 'FAQ', url: '/faq/' }];
---

<Layout
  title="FAQ - MOQ, Quotations, Shipping, OEM & Support | IPTVStream"
  description="Answers on ordering the FMUSER FUQ headend line: MOQ, quotation turnaround, payment, lead time, OEM and ODM options, warranty terms and technical support."
  schema={faqSchema}
  breadcrumbs={breadcrumbs}
>
  <!-- ===== 页面标题 ===== -->
  <section class="relative bg-[#f5f5f7] py-16 lg:py-24 text-center border-b border-[#e8e8ed] overflow-hidden" aria-label="FAQ overview">
    <div class="relative container mx-auto max-w-3xl px-4">
      <p class="text-[#0071e3] text-sm font-semibold tracking-[0.2em] uppercase mb-4">FAQ</p>
      <h1 class="text-4xl lg:text-6xl font-bold text-[#1d1d1f] tracking-tight mb-5">Frequently Asked <span class="gradient-text">Questions</span></h1>
      <p class="text-[#6e6e73] text-lg">Ordering, specifications, shipping and support — answered without the brochure talk.</p>
    </div>
  </section>

  <!-- ===== FAQ 列表 ===== -->
  <section class="py-16 lg:py-24 bg-white" aria-label="Frequently asked questions">
    <div class="container mx-auto max-w-4xl px-4">
      <div class="space-y-4">
        {
          faqs.map((f, i) => (
            <details class="group bg-[#f5f5f7] rounded-2xl border border-[#e8e8ed] overflow-hidden" open={i === 0}>
              <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none font-semibold text-[#1d1d1f] hover:text-[#0071e3] transition-colors">
                <span class="flex items-center gap-4"><span class="text-[#0071e3] font-bold text-sm">{String(i + 1).padStart(2, '0')}</span>{f.q}</span>
                <i class="fas fa-chevron-down text-xs text-[#86868b] transition-transform group-open:rotate-180"></i>
              </summary>
              <div class="px-6 pb-5 pl-16 text-[#6e6e73] leading-relaxed">{f.a}</div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="py-16 lg:py-24 bg-[#f5f5f7]" aria-label="Ask a question">
    <div class="container mx-auto max-w-4xl px-4 text-center reveal">
      <h2 class="text-3xl lg:text-4xl font-bold text-[#1d1d1f] tracking-tight mb-4">Still Have <span class="gradient-text">Questions?</span></h2>
      <p class="text-[#6e6e73] text-lg mb-8">Send the model or the requirement and we will answer with the datasheet in hand.</p>
      <a href="/contact/" class="btn-primary text-base px-10 py-4">
        <i class="fas fa-comments"></i> Ask Your Question
      </a>
    </div>
  </section>
</Layout>
