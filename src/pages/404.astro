---
import Layout from '../layouts/Layout.astro';

const breadcrumbs = [{ name: '404', url: '/404.html' }];
---

<Layout
  title="Page Not Found | IPTVStream"
  description="The page you are looking for could not be found."
  breadcrumbs={breadcrumbs}
>
  <!-- ===== 404 ===== -->
  <section class="bg-[#f5f5f7] min-h-[60vh] flex items-center" aria-label="Page not found">
    <div class="container mx-auto max-w-3xl px-4 text-center py-24">
      <p class="text-8xl lg:text-9xl font-bold text-[#1d1d1f] tracking-tight mb-6">404</p>
      <h1 class="text-3xl lg:text-4xl font-bold text-[#1d1d1f] tracking-tight mb-4">Page Not Found</h1>
      <p class="text-[#6e6e73] text-lg mb-10">The page you are looking for may have been moved or no longer exists.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="btn-primary text-base px-10 py-4">
          <i class="fas fa-house"></i> Back to Home
        </a>
        <a href="/products/" class="btn-ghost text-base px-10 py-4">
          <i class="fas fa-box"></i> Browse Products
        </a>
      </div>
      <div class="mt-12">
        <a href="/search/" class="inline-flex items-center gap-2 text-[#0071e3] font-semibold hover:underline">
          <i class="fas fa-magnifying-glass"></i> Try searching instead
        </a>
      </div>
    </div>
  </section>
</Layout>
