---
// ============================================================
// solutions.astro - four headend solutions, built from the real catalogue
// Rules that drove this rewrite:
//   * the old page recommended products that do not exist (FBE700, FBE013,
//     DSTL-10 Wireless STL) and a "5.8 GHz wireless" solution the catalogue has
//     nothing behind -> removed; every model named here is a real catalogue entry
//     and every "browse" link is a live filtered catalogue URL
//   * visual language follows direction D (same as / and /products/)
// ============================================================
import Layout from '../layouts/Layout.astro';
import { PRODUCTS } from '../data/products';
import { thumbOf, modelOf, short } from '../lib/product';

const SITE = 'https://www.iptv-demo.example.com';

const pickModels = (test, n = 4) =>
  PRODUCTS.filter((p) => test(p) && p.image).slice(0, n);

const catCount = (test) => PRODUCTS.filter(test).length;

const SOLUTIONS = [
  {
    id: 'digital-headend',
    eyebrow: 'Solution 01',
    title: 'Digital headend',
    lead: 'Everything that turns program sources into a transport stream: HDMI/SDI and IP inputs in, IP, ASI or a coax RF channel out. Sized by channel count and by the standard your market distributes in.',
    bullets: [
      'H.265, H.264 and MPEG-2 encoding over HDMI, SDI, CVBS or IP inputs',
      'Dense chassis: up to 48 HDMI inputs in one 2-U encoder',
      'Encoder-modulators that put the RF channel straight on the coax',
      'Multiplexing, PSI/SI, EPG and scrambling handled in the same chain',
    ],
    test: (p) => p.category === 'encoder' || p.category === 'encoder-modulator',
    browse: { href: '/products/?cat=encoder', label: 'Browse every encoder model' },
    extra: { href: '/products/?cat=encoder-modulator', label: 'Encoder modulators' },
  },
  {
    id: 'iptv-hospitality',
    eyebrow: 'Solution 02',
    title: 'IPTV and hospitality platforms',
    lead: 'Headends for hotels, hospitals, campuses, cruise ships and ISP communities: the multicast line-up, the middleware, the EPG and the guest-facing layer.',
    bullets: [
      'Hotel IPTV platforms with VOD, welcome pages and multi-language guest menus',
      'EPG servers scaling to 2044 transport streams, DVB- and ATSC-compliant',
      'IP gateways that hand the multicast stream to the access switches',
      'Subscriber management and advertising insertion systems',
    ],
    test: (p) => /iptv|hotel|epg|vod|subscriber|advertis/i.test(p.name),
    browse: { href: '/products/?q=iptv', label: 'Browse the IPTV and EPG systems' },
    extra: { href: '/products/?cat=ip-gateway', label: 'IP gateways' },
  },
  {
    id: 'satellite-turnaround',
    eyebrow: 'Solution 03',
    title: 'Satellite and RF turn-around',
    lead: 'Take a satellite or IF feed down to the cable, terrestrial or IP network your subscribers are actually connected to — with the tuner count and output standard you need.',
    bullets: [
      'DVB-S/S2/S2X tuners to DVB-C, DVB-T, ISDB-T or ATSC output',
      'IF modulators for uplink and contribution chains, 950-2150 MHz',
      'Satellite modems with an Ethernet/IP output (FUQ-4515)',
      '1-4 ASI inputs, 16-24 tuner density in one unit',
    ],
    test: (p) => /dvb-s|satellite|transmodulator/i.test(p.name),
    browse: { href: '/products/?q=DVB-S', label: 'Browse satellite and DVB-S models' },
    extra: { href: '/products/?cat=modulator', label: 'All modulators' },
  },
  {
    id: 'transmission',
    eyebrow: 'Solution 04',
    title: 'Terrestrial and FM transmission',
    lead: 'The transmitter end of the chain: DVB-T coverage for a regional network and FM stereo broadcast, from 10 W community stations to 10 kW regional services.',
    bullets: [
      'DVB-T transmitters from 10 W to 1.2 kW, adjustable output',
      'FM stereo broadcast transmitters 10 W to 10 kW',
      'Single-channel and multi-channel rack configurations',
      'Headend processors and stream monitoring for the input side',
    ],
    test: (p) => p.category === 'transmitter' || /transmitter/i.test(p.name),
    browse: { href: '/products/?cat=transmitter', label: 'Browse transmitters' },
    extra: { href: '/contact/', label: 'Plan coverage with us' },
  },
];

const cards = SOLUTIONS.map((s) => ({
  ...s,
  models: pickModels(s.test, 4),
  count: catCount(s.test),
}));

const TOTAL = PRODUCTS.length;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Broadcast Solutions - Digital Headend, IPTV, Satellite Turn-around and Transmission',
    url: `${SITE}/solutions/`,
    description:
      'Four headend and transmission solutions built from the 191-model FMUSER line: encoding, IPTV and hospitality platforms, satellite turn-around and DVB-T/FM transmission.',
    isPartOf: { '@type': 'WebSite', name: 'IPTVStream Broadcast', url: SITE },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: cards.map((s, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: s.title,
        url: `${SITE}/solutions/#${s.id}`,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: 'Solutions', item: `${SITE}/solutions/` },
    ],
  },
];

const breadcrumbs = [{ name: 'Solutions', url: '/solutions/' }];
---

<Layout
  title="Broadcast Solutions - Headend, IPTV, Satellite & Transmission | IPTVStream"
  description="Four solutions built from the 191-model FMUSER line: HDMI/SDI and IP encoding, IPTV and hotel platforms, satellite to DVB-C/T turn-around, DVB-T and FM transmission from 10 W to 10 kW."
  schema={schema}
  breadcrumbs={breadcrumbs}
>
  <!-- ===== hero ===== -->
  <section class="bg-white pt-10 pb-8 lg:pt-14 lg:pb-10" aria-label="Solutions introduction">
    <div class="container mx-auto max-w-7xl px-4">
      <p class="sl-eyebrow">Solutions</p>
      <h1 class="mt-3 text-[38px] lg:text-[60px] font-bold leading-[1.06] tracking-tight text-[#1d1d1f]">
        From the satellite feed<br class="hidden lg:block" /> to the screen or the antenna
      </h1>
      <p class="mt-5 max-w-3xl text-base lg:text-lg leading-relaxed text-[#6e6e73]">
        We configure headend and transmission chains from the same {TOTAL}-model line you can browse in the
        catalogue — encoders and encoder-modulators, modulators and transmodulators, IP gateways, multiplexers,
        EPG and IPTV server software, DVB-T and FM transmitters. Send the channel plan and the output standard;
        we come back with the model list.
      </p>
      <nav class="sl-jump" aria-label="Solutions on this page">
        {cards.map((s) => (
          <a href={`#${s.id}`}>{s.title}</a>
        ))}
      </nav>
    </div>
  </section>

  <!-- ===== solution blocks (alternating) ===== -->
  {
    cards.map((s, i) => (
      <section id={s.id} class="scroll-mt-28 border-t border-[#e8e8ed] bg-white py-12 lg:py-16" aria-label={s.title}>
        <div class="container mx-auto max-w-7xl px-4">
          <div class="grid gap-10 lg:grid-cols-2 lg:gap-14 items-start">
            <div class={i % 2 === 1 ? 'lg:order-2' : ''}>
              <p class="sl-eyebrow">{s.eyebrow}</p>
              <h2 class="mt-2 text-[26px] lg:text-[34px] font-bold leading-[1.15] tracking-tight text-[#1d1d1f]">{s.title}</h2>
              <p class="mt-4 text-[16.5px] leading-relaxed text-[#6e6e73]">{s.lead}</p>
              <ul class="sl-points">
                {s.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
              <div class="sl-links">
                <a href={s.browse.href} class="sl-link">
                  {s.browse.label} <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </a>
                <a href={s.extra.href} class="sl-link sl-link-quiet">
                  {s.extra.label}
                </a>
              </div>
            </div>

            <div class={i % 2 === 1 ? 'lg:order-1' : ''}>
              <div class="sl-panel">
                <div class="sl-panel-head">
                  <span>{s.count} models in this group</span>
                  <a href={s.browse.href} class="sl-panel-all">See all</a>
                </div>
                <div class="sl-models">
                  {s.models.map((p) => (
                    <a href={`/products/${p.slug}/`} class="sl-model">
                      <div class="sl-model-thumb">
                        <img src={thumbOf(p.image)} alt={p.name} loading="lazy" decoding="async" />
                      </div>
                      <div class="sl-model-body">
                        <span class="sl-model-id">{modelOf(p)}</span>
                        <h3>{short(p.name.replace(/^FUQ[-\s]*[A-Z0-9-]+\s*/i, ''), 54) || p.name}</h3>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <!-- ===== CTA ===== -->
  <section class="bg-[#f5f5f7] py-16 lg:py-20" aria-label="Request a system design">
    <div class="container mx-auto max-w-4xl px-4 text-center">
      <h2 class="text-3xl lg:text-4xl font-bold tracking-tight text-[#1d1d1f]">Have a channel plan or a coverage target?</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-[#6e6e73]">
        Tell us the input sources, the outlet standard and the number of programs. We map it onto the catalogue,
        confirm the configuration against the datasheets and send pricing, lead time and shipping options.
      </p>
      <a href="/contact/" class="btn-primary mt-8 text-base px-10 py-4">
        <i class="fas fa-paper-plane" aria-hidden="true"></i> Send your requirements
      </a>
    </div>
  </section>

  <style is:global>
    .sl-eyebrow {
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: #0071e3;
    }
    .sl-jump {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 1.6rem;
    }
    .sl-jump a {
      font-size: 12.5px;
      font-weight: 600;
      color: #6e6e73;
      background: #f5f5f7;
      border: 1px solid #e8e8ed;
      border-radius: 999px;
      padding: 0.4rem 0.85rem;
      transition: color 0.18s, border-color 0.18s;
    }
    .sl-jump a:hover {
      color: #0071e3;
      border-color: rgba(0, 113, 227, 0.45);
    }
    .sl-points {
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      margin-top: 1.35rem;
    }
    .sl-points li {
      position: relative;
      padding-left: 1.35rem;
      font-size: 14.5px;
      line-height: 1.6;
      color: #1d1d1f;
    }
    .sl-points li::before {
      content: '';
      position: absolute;
      left: 0.15rem;
      top: 0.55rem;
      width: 6px;
      height: 6px;
      border-radius: 999px;
      background: #0071e3;
    }
    .sl-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem 1.5rem;
      margin-top: 1.5rem;
    }
    .sl-link {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      font-size: 14.5px;
      font-weight: 600;
      color: #0071e3;
    }
    .sl-link i {
      font-size: 11px;
      transition: transform 0.2s;
    }
    .sl-link:hover i {
      transform: translateX(3px);
    }
    .sl-link-quiet {
      color: #6e6e73;
      font-weight: 500;
    }
    .sl-link-quiet:hover {
      color: #0071e3;
    }

    /* product panel */
    .sl-panel {
      border: 1px solid #e8e8ed;
      border-radius: 20px;
      background: #f5f5f7;
      padding: 1.1rem;
    }
    .sl-panel-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.15rem 0.35rem 0.85rem;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #86868b;
    }
    .sl-panel-all {
      color: #0071e3;
      text-transform: none;
      letter-spacing: 0;
      font-size: 12.5px;
    }
    .sl-panel-all:hover {
      text-decoration: underline;
    }
    .sl-models {
      display: grid;
      gap: 0.6rem;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .sl-model {
      display: flex;
      gap: 0.7rem;
      align-items: center;
      background: #fff;
      border: 1px solid #e8e8ed;
      border-radius: 14px;
      padding: 0.6rem;
      transition: border-color 0.2s, box-shadow 0.25s, transform 0.25s;
    }
    .sl-model:hover {
      border-color: rgba(0, 113, 227, 0.45);
      box-shadow: 0 10px 26px rgba(0, 0, 0, 0.06);
      transform: translateY(-2px);
    }
    .sl-model-thumb {
      flex: 0 0 auto;
      width: 54px;
      height: 54px;
      border-radius: 10px;
      background: #f5f5f7;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 5px;
    }
    .sl-model-thumb img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
    }
    .sl-model-body {
      min-width: 0;
    }
    .sl-model-id {
      display: block;
      font-size: 10.5px;
      font-weight: 700;
      letter-spacing: 0.06em;
      color: #0071e3;
    }
    .sl-model-body h3 {
      margin-top: 0.15rem;
      font-size: 12.5px;
      font-weight: 600;
      line-height: 1.35;
      color: #1d1d1f;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    @media (max-width: 640px) {
      .sl-models {
        grid-template-columns: minmax(0, 1fr);
      }
    }
  </style>
</Layout>
