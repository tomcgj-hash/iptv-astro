---
// ============================================================
// index.astro — homepage (Direction D: studio structure + model finder)
// Structure: centred headline -> full-width product stage -> trust strip -> two image/text chapters
//          -> chapter 3 (full-width figure + spec strip) -> model finder
//          -> key numbers -> dark factory band -> guides -> closing CTA
// Data: everything is derived from products.js / posts.js (no hard-coded models or counts)
// ============================================================
import Layout from '../layouts/Layout.astro';
import { PRODUCTS, CAT_NAMES } from '../data/products';
import { CAT_IMAGES } from '../data/catImages';
import { getPosts } from '../data/posts';

const latestPosts = getPosts().slice(0, 3);

const catFirstImage = (cat) =>
  CAT_IMAGES[cat] || (PRODUCTS.find((x) => x.category === cat && x.image) || {}).image || '';

// ---------- hero stage uses a real product photo ----------
const heroProduct = PRODUCTS.find((p) => p.category === 'encoder' && p.image) || PRODUCTS[0];
const heroSpec = Object.values(heroProduct.specs || {})[0] || '';

// ---------- model finder data (generated at build time from the real catalogue) ----------
const short = (s, n) => String(s || '').replace(/\s+/g, ' ').trim().slice(0, n);
const MODELS = PRODUCTS.map((p) => {
  const sp = Object.entries(p.specs || {})[0];
  return {
    n: short(p.name, 64),
    c: p.category,
    s: sp ? short(`${sp[0]}: ${sp[1]}`, 56) : '',
    u: `/products/${p.slug}/`,
  };
});
const CATS = Object.entries(CAT_NAMES)
  .map(([id, label]) => ({ id, label, count: PRODUCTS.filter((p) => p.category === id).length }))
  .filter((c) => c.count > 0)
  .sort((a, b) => b.count - a.count);

const MODEL_COUNT = PRODUCTS.length;
const CAT_COUNT = CATS.length;

// ---------- image/text chapters ----------
const chapters = [
  {
    kicker: 'Encoding',
    title: 'From one HDMI to forty-eight.',
    body: 'Broadcast-grade HEVC, H.264 and MPEG-2 encoding with UDP/RTP/RTSP output. Rack units built for 24/7 headend duty, not for a demo shelf.',
    image: catFirstImage('encoder'),
    link: '/products/#cat-encoder',
    cta: 'See encoders',
  },
  {
    kicker: 'Modulation',
    title: 'Whatever standard your market uses.',
    body: 'QAM, ATSC, DVB-T, ISDB-T, DVB-S2 and IP output — 1 to 64 channels, aligned and tested on our own RF bench before it leaves the building.',
    image: catFirstImage('modulator'),
    link: '/products/#cat-modulator',
    cta: 'See modulators',
  },
];
const specStrip = [
  { k: 'IP output', v: 'UDP · RTP · multicast' },
  { k: 'VOD library', v: 'on-demand content' },
  { k: 'EPG', v: 'multi-language' },
  { k: 'Control', v: 'remote web management' },
];

// homepage schema: Organization
const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'IPTVStream Broadcast',
  description:
    'Professional digital TV headend equipment manufacturer from China. Encoders, modulators, IP gateways, multiplexers and transmitters for broadcasters worldwide.',
  url: Astro.site?.toString() || 'https://www.iptv-demo.example.com',
  logo: `${Astro.site?.toString() || 'https://www.iptv-demo.example.com'}images/logo.svg`,
  address: { '@type': 'PostalAddress', addressCountry: 'China' },
  areaServed: 'Worldwide',
};
---

<Layout
  title="Professional Digital TV Headend Equipment Manufacturer | IPTVStream Broadcast"
  description={`Factory-direct digital TV headend equipment from China — encoders, modulators, IP gateways, multiplexers and transmitters. ${MODEL_COUNT} models in ${CAT_COUNT} categories, ISO 9001 certified, shipped to 50+ countries.`}
  schema={homeSchema}
>
  <!-- ===== Hero: centred headline + full-width product stage ===== -->
  <section class="pt-12 lg:pt-16 text-center" aria-label="Hero">
    <div class="container mx-auto max-w-7xl px-4">
      <p class="text-[12.5px] font-semibold tracking-[0.14em] uppercase text-[#86868b]">
        Digital TV headend · Built in our own factory
      </p>
      <h1
        class="mt-5 mb-5 text-[40px] sm:text-[58px] lg:text-[80px] font-semibold tracking-[-0.045em] leading-[1.02] text-[#1d1d1f] max-w-[17ch] mx-auto"
      >
        Every part of the chain.
      </h1>
      <p class="text-[18px] lg:text-[21px] text-[#6e6e73] leading-relaxed max-w-[46ch] mx-auto">
        Encoders, modulators, IP gateways, multiplexers, transmitters. One supplier, one factory line,
        {MODEL_COUNT} models.
      </p>
      <div class="flex flex-wrap gap-3.5 justify-center mt-9">
        <a href="#catalogue" class="btn-primary">
          <i class="fas fa-box"></i> Browse products
        </a>
        <a href="/contact/" class="btn-ghost">
          <i class="fas fa-comments"></i> Request a quote
        </a>
      </div>
    </div>

    <div class="container mx-auto max-w-[1320px] px-4 mt-14">
      <div class="relative bg-[#f5f5f7] rounded-[28px] lg:rounded-[34px] px-5 py-9 lg:px-6 lg:py-11 overflow-hidden reveal">
        <span class="absolute top-5 left-1/2 -translate-x-1/2 text-[12.5px] text-[#86868b]">
          FMUSER headend series
        </span>
        <img
          src={heroProduct.image}
          alt={`${heroProduct.name} — broadcast headend unit`}
          class="mx-auto max-h-[240px] lg:max-h-[450px] w-auto object-contain transition-transform duration-500 ease-out"
          loading="eager"
        />
        <div class="mt-6 text-[15px] text-[#6e6e73]">
          <b class="text-[#1d1d1f]">{heroProduct.name}</b>
          {heroSpec && <span> — {heroSpec}</span>}
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Trust strip ===== -->
  <div class="mt-14 lg:mt-16 border-y border-[#e8e8ed]">
    <div
      class="container mx-auto max-w-[1320px] px-4 py-5 lg:py-6 flex flex-wrap justify-center gap-x-10 gap-y-3 text-[13.5px] text-[#86868b] reveal"
    >
      <span><b class="text-[#1d1d1f]">ISO 9001:2015</b> certified</span>
      <span>CE · RoHS · FCC</span>
      <span><b class="text-[#1d1d1f]">24-hour</b> burn-in on every unit</span>
      <span><b class="text-[#1d1d1f]">50+</b> countries served</span>
      <span><b class="text-[#1d1d1f]">12-month</b> warranty</span>
    </div>
  </div>

  <!-- ===== Chapters 1-2: alternating image / text ===== -->
  <section class="py-20 lg:py-[104px]" aria-label="Product chapters">
    <div class="container mx-auto max-w-[1180px] px-4">
      {
        chapters.map((c, i) => (
          <div class:list={['grid lg:grid-cols-2 gap-10 lg:gap-16 items-center reveal', i > 0 && 'mt-20 lg:mt-[104px]']}>
            <div class:list={['bg-[#f5f5f7] rounded-[28px] p-8 lg:p-9 flex items-center justify-center h-[260px] lg:h-[392px]', i % 2 === 1 && 'lg:order-2']}>
              <img src={c.image} alt={c.title} class="max-h-full object-contain" loading="lazy" />
            </div>
            <div class:list={[i % 2 === 1 && 'lg:order-1']}>
              <p class="text-[12.5px] font-semibold tracking-[0.14em] uppercase text-[#86868b]">{c.kicker}</p>
              <h2 class="mt-4 mb-4 text-[28px] lg:text-[44px] font-semibold tracking-[-0.035em] leading-[1.08] text-[#1d1d1f] max-w-[16ch]">
                {c.title}
              </h2>
              <p class="text-[17px] lg:text-[18.5px] text-[#6e6e73] leading-relaxed">{c.body}</p>
              <a href={c.link} class="inline-flex items-center gap-2 text-[#0071e3] font-medium mt-5 text-[16px] hover:underline">
                {c.cta} <i class="fas fa-arrow-right text-xs"></i>
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ===== Chapter 3: full-width figure with an overlaid spec strip ===== -->
  <section class="pb-20 lg:pb-24 -mt-4" aria-label="IPTV distribution">
    <div class="container mx-auto max-w-[1180px] px-4 text-center mb-9 reveal">
      <p class="text-[12.5px] font-semibold tracking-[0.14em] uppercase text-[#86868b]">Distribution</p>
      <h2 class="mt-4 mb-3.5 text-[28px] lg:text-[44px] font-semibold tracking-[-0.035em] leading-[1.08] text-[#1d1d1f] max-w-[20ch] mx-auto">
        Satellite in, IP out, to every screen.
      </h2>
      <p class="text-[17px] lg:text-[19px] text-[#6e6e73] leading-relaxed max-w-[50ch] mx-auto">
        IPTV gateway servers for hotels, hospitals, campuses and ISPs — with VOD, multi-language EPG and
        remote management.
      </p>
    </div>
    <div class="container mx-auto max-w-[1320px] px-4 reveal">
      <figure class="hl-widefig">
        <img src={catFirstImage('ip-gateway')} alt="IPTV gateway server" loading="lazy" />
        <figcaption class="hl-specstrip">
          {specStrip.map((s) => (
            <span class="hl-si">
              <b>{s.k}</b>
              <i>{s.v}</i>
            </span>
          ))}
          <a href="/products/#cat-ip-gateway" class="hl-sgo">See IP gateways →</a>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ===== Model finder (built from the real catalogue) ===== -->
  <section id="catalogue" class="hl-finder-sec" aria-label="Model finder">
    <div class="container mx-auto max-w-7xl px-4 text-center reveal">
      <p class="text-[12.5px] font-semibold tracking-[0.14em] uppercase text-[#86868b]">Model finder</p>
      <h2 class="mt-4 mb-3 text-[28px] lg:text-[44px] font-semibold tracking-[-0.035em] leading-[1.08] text-[#1d1d1f]">
        Search the catalogue.
      </h2>
      <p class="text-[17px] lg:text-[19px] text-[#6e6e73] leading-relaxed max-w-[48ch] mx-auto">
        Type a model prefix or a keyword — <span class="hl-mono">FUQ4339</span>,
        <span class="hl-mono">8 HDMI</span>, <span class="hl-mono">QAM</span> — then narrow it down by
        category.
      </p>
    </div>

    <div class="container mx-auto max-w-[1180px] px-4 mt-9">
      <div class="hl-fpanel reveal">
        <div class="hl-frow">
          <label class="hl-fsearch">
            <i class="fas fa-magnifying-glass"></i>
            <input
              id="mf-q"
              type="search"
              placeholder={`Search ${MODEL_COUNT} models by name, type or spec…`}
              autocomplete="off"
              aria-label="Search models"
            />
          </label>
          <span class="hl-fcount" id="mf-count">Showing {MODEL_COUNT} of {MODEL_COUNT}</span>
        </div>

        <div class="hl-cats" id="mf-cats">
          <button type="button" class="hl-cbtn on" data-c="all">
            All <i>{MODEL_COUNT}</i>
          </button>
          {CATS.map((c) => (
            <button type="button" class="hl-cbtn" data-c={c.id}>
              {c.label} <i>{c.count}</i>
            </button>
          ))}
        </div>

        <div class="hl-list">
          <div class="hl-row head">
            <span>Model</span><span>Category</span><span>Key specification</span><span></span>
          </div>
          <div id="mf-rows"></div>
        </div>

        <div class="hl-more" id="mf-more" style="display:none"></div>
      </div>
    </div>
  </section>

  <!-- ===== Key numbers ===== -->
  <section class="py-20 lg:py-24" aria-label="Company numbers">
    <div class="container mx-auto max-w-[1320px] px-4 reveal">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10 text-center">
        {
          [
            { n: MODEL_COUNT, suffix: '', label: 'Models in catalogue' },
            { n: CAT_COUNT, suffix: '', label: 'Equipment categories' },
            { n: 50, suffix: '+', label: 'Export markets' },
            { n: 24, suffix: 'h', label: 'Burn-in per unit' },
          ].map((s) => (
            <div>
              <b
                class="block text-[38px] lg:text-[56px] font-semibold tracking-[-0.04em] leading-none text-[#1d1d1f]"
                data-count={s.n}
                data-suffix={s.suffix}
              >
                {s.n}
                {s.suffix}
              </b>
              <span class="block mt-3 text-[14.5px] text-[#86868b]">{s.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== Factory band (dark) ===== -->
  <section class="bg-[#1d1d1f] py-20 lg:py-24" aria-label="The factory">
    <div class="container mx-auto max-w-7xl px-4">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center reveal">
        <div>
          <p class="text-[12.5px] font-semibold tracking-[0.14em] uppercase text-white/50">The factory</p>
          <h2 class="mt-4 mb-4 text-[28px] lg:text-[44px] font-semibold tracking-[-0.035em] leading-[1.08] text-white">
            We build what we ship.
          </h2>
          <p class="text-[17px] lg:text-[18.5px] text-white/75 leading-relaxed">
            SMT assembly, firmware, RF alignment and a 24-hour burn-in run happen on one site in Guangzhou.
            Nothing is rebadged — the unit you receive is the unit we measured.
          </p>
          <a href="/about/" class="inline-flex items-center gap-2 text-[#5ac8fa] font-medium mt-6 text-[16px] hover:underline">
            Inside the factory <i class="fas fa-arrow-right text-xs"></i>
          </a>
        </div>
        <div class="bg-white/5 rounded-[28px] p-8 flex items-center justify-center h-[260px] lg:h-[380px]">
          <img
            src="/images/factory/factory-floor.jpg"
            alt="Production line at our Guangzhou factory"
            class="max-h-full object-contain rounded-[16px]"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Guides ===== -->
  <section class="py-20 lg:py-24" aria-label="Guides">
    <div class="container mx-auto max-w-7xl px-4">
      <div class="flex items-end justify-between gap-6 mb-11 reveal">
        <div>
          <p class="text-[12.5px] font-semibold tracking-[0.14em] uppercase text-[#86868b]">Guides</p>
          <h2 class="mt-3.5 text-[28px] lg:text-[44px] font-semibold tracking-[-0.035em] leading-[1.08] text-[#1d1d1f]">
            Before you buy.
          </h2>
        </div>
        <a href="/blog/" class="hidden sm:inline-flex items-center gap-2 text-[#0071e3] font-medium text-[15px] hover:underline">
          All articles <i class="fas fa-arrow-right text-xs"></i>
        </a>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-7">
        {
          latestPosts.map((post) => (
            <a href={`/blog/${post.slug}/`} class="group block reveal">
              <div class="bg-[#f5f5f7] rounded-[20px] overflow-hidden aspect-[16/10]">
                <img
                  src={`/images/blog/${post.slug}.jpg`}
                  alt={post.title}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                  loading="lazy"
                />
              </div>
              <b class="block mt-4 text-[19px] font-semibold tracking-[-0.015em] leading-snug text-[#1d1d1f] group-hover:text-[#0071e3] transition-colors">
                {post.title}
              </b>
              <p class="mt-2 text-[14px] text-[#86868b]">{post.category} · {post.date}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== Closing CTA ===== -->
  <section class="pb-20 lg:pb-24 text-center" aria-label="Contact">
    <div class="container mx-auto max-w-7xl px-4">
      <h2 class="text-[32px] lg:text-[64px] font-semibold tracking-[-0.04em] leading-[1.05] text-[#1d1d1f] max-w-[20ch] mx-auto">
        Tell us your channel plan.
      </h2>
      <div class="flex flex-wrap gap-3.5 justify-center mt-8">
        <a href="/contact/" class="btn-primary"><i class="fas fa-paper-plane"></i> Request a quotation</a>
        <a href="/products/" class="btn-ghost"><i class="fas fa-box"></i> Browse all models</a>
      </div>
      <div class="flex flex-wrap justify-center gap-x-8 gap-y-3 mt-10 text-[14.5px] text-[#86868b]">
        <span><i class="fas fa-envelope mr-2"></i>sales@coaxtoiptv.com</span>
        <span><i class="fas fa-phone mr-2"></i>+86-139-2270-2227</span>
        <span><i class="fas fa-clock mr-2"></i>Mon–Sat, 9:00–18:00 (GMT+8)</span>
      </div>
    </div>
  </section>

  <!-- Model finder script (data injected at build time, no extra request) -->
  <script is:inline define:vars={{ MODELS, CATS }}>
    (function () {
      var list = document.getElementById('mf-rows');
      if (!list) return;
      var countEl = document.getElementById('mf-count');
      var catsEl = document.getElementById('mf-cats');
      var moreEl = document.getElementById('mf-more');
      var inputEl = document.getElementById('mf-q');
      var nameById = {};
      CATS.forEach(function (c) {
        nameById[c.id] = c.label;
      });
      var active = 'all';
      var shown = 12;
  
      function esc(s) {
        return String(s).replace(/[&<>"]/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
        });
      }
  
      function render() {
        var q = (inputEl.value || '').trim().toLowerCase();
        var out = MODELS.filter(function (m) {
          if (active !== 'all' && m.c !== active) return false;
          if (!q) return true;
          return (m.n + ' ' + m.c + ' ' + (m.s || '')).toLowerCase().indexOf(q) > -1;
        });
        countEl.textContent = 'Showing ' + out.length + ' of ' + MODELS.length;
        list.innerHTML = out.length
          ? out
              .slice(0, shown)
              .map(function (m) {
                return (
                  '<a class="hl-row" href="' + esc(m.u) + '"><b>' + esc(m.n) + '</b>' +
                  '<span class="hl-cm">' + esc(nameById[m.c] || m.c) + '</span>' +
                  '<span class="hl-sp">' + esc(m.s || '—') + '</span>' +
                  '<span class="hl-go">Specs →</span></a>'
                );
              })
              .join('')
          : '<div class="hl-empty">No model matches that search.</div>';
  
        if (out.length > shown) {
          moreEl.style.display = 'flex';
          moreEl.innerHTML =
            '<span>Showing first ' + shown + ' of ' + out.length + '</span><a href="#" id="mf-all">Show all →</a>';
          document.getElementById('mf-all').addEventListener('click', function (e) {
            e.preventDefault();
            shown = out.length;
            render();
          });
        } else {
          moreEl.style.display = 'none';
        }
      }
  
      catsEl.addEventListener('click', function (e) {
        var b = e.target.closest('.hl-cbtn');
        if (!b) return;
        catsEl.querySelectorAll('.hl-cbtn').forEach(function (x) {
          x.classList.remove('on');
        });
        b.classList.add('on');
        active = b.getAttribute('data-c');
        shown = 12;
        render();
      });
  
      inputEl.addEventListener('input', function () {
        shown = 12;
        render();
      });
  
      // Nav search (the shared #nav-search-input, injected later by js/main.js) drives this
      // page's finder. main.js fires a jQuery event, so bind through jQuery when available
      // and also poll briefly as a fallback for the case where jQuery is unavailable.
      function bindNavSearch() {
        var nav = document.getElementById('nav-search-input');
        if (!nav || nav.getAttribute('data-bound') === '1') return;
        nav.setAttribute('data-bound', '1');
        nav.addEventListener('input', function () {
          inputEl.value = nav.value;
          shown = 12;
          render();
        });
        var form = nav.closest('form');
        if (form) {
          form.addEventListener('submit', function (e) {
            e.preventDefault();
            var target = document.getElementById('catalogue');
            if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
        }
      }
      if (window.jQuery) {
        window.jQuery(document).on('component:loaded', bindNavSearch);
      }
      var navTries = 0;
      var navTimer = setInterval(function () {
        bindNavSearch();
        if (++navTries > 40) clearInterval(navTimer);
      }, 250);
      bindNavSearch();
  
      render();
  
      // number count-up for the four key figures
      var nums = document.querySelectorAll('[data-count]');
      if (window.IntersectionObserver && nums.length) {
        nums.forEach(function (el) {
          var target = +el.getAttribute('data-count');
          var suffix = el.getAttribute('data-suffix') || '';
          var done = false;
          new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting && !done) {
                  done = true;
                  var t0 = performance.now();
                  (function tick(now) {
                    var p = Math.min(1, (now - t0) / 900);
                    var eased = 1 - Math.pow(1 - p, 3);
                    el.textContent = Math.round(target * eased) + suffix;
                    if (p < 1) requestAnimationFrame(tick);
                  })(t0);
                }
              });
            },
            { threshold: 0.4 }
          ).observe(el);
        });
      }
    })();
  </script>
</Layout>

<!-- ============================================================
     Homepage-only styles (Direction D components). Global because no other page uses them.
     ============================================================ -->
<style is:global>
  /* ---------- Chapter 3: full-width figure with an overlaid spec strip ---------- */
  .hl-widefig {
    position: relative;
    margin: 0;
    background: #f5f5f7;
    border-radius: 24px;
    padding: 26px 16px 26px;
    overflow: hidden;
  }
  .hl-widefig img {
    max-height: 250px;
    margin: 0 auto;
    object-fit: contain;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .hl-widefig:hover img {
    transform: scale(1.02);
  }
  .hl-specstrip {
    position: static;
    margin: 22px 0 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px 20px;
    padding: 16px 18px;
    background: rgba(255, 255, 255, 0.78);
    -webkit-backdrop-filter: blur(18px) saturate(180%);
    backdrop-filter: blur(18px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.92);
    border-radius: 18px;
    box-shadow: 0 12px 34px rgba(0, 0, 0, 0.07);
  }
  .hl-si {
    min-width: 0;
  }
  .hl-si b {
    display: block;
    font-size: 14.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .hl-si i {
    display: block;
    font-style: normal;
    font-size: 12.5px;
    color: #86868b;
  }
  .hl-sgo {
    grid-column: 1 / -1;
    justify-self: start;
    color: #0071e3;
    font-size: 15px;
    font-weight: 500;
    white-space: nowrap;
  }
  /* Wide screens: the spec strip sits on the image (>=1101px, matches the approved mockup) */
  @media (min-width: 1101px) {
