---
// ============================================================
// refund.astro - legacy URL kept alive.
// The old "Refund Policy" was a consumer IPTV-service document (7-day money-back
// guarantee etc.) that does not apply to equipment sales. The content now lives on
// /warranty-returns/; this page exists so old links, bookmarks and any indexed URL
// do not hit a 404.
// ============================================================
import Layout from '../layouts/Layout.astro';

const breadcrumbs = [{ name: 'Warranty and Returns', url: '/warranty-returns/' }];
---

<Layout
  title="Warranty and Returns | FMUSER"
  description="This page has moved: warranty, DOA and return handling for FMUSER equipment is now documented on the Warranty and Returns page."
  breadcrumbs={breadcrumbs}
>
  <meta slot="head" name="robots" content="noindex, follow" />
  <meta slot="head" http-equiv="refresh" content="0; url=/warranty-returns/" />
  <section class="py-16 lg:py-24 bg-white" aria-label="Page moved">
    <div class="container mx-auto max-w-2xl px-4 text-center">
      <p class="text-[12.5px] font-semibold tracking-[0.14em] uppercase text-[#0071e3]">Moved</p>
      <h1 class="mt-3 text-[30px] lg:text-[40px] font-bold tracking-tight text-[#1d1d1f]">
        Warranty and returns
      </h1>
      <p class="mt-4 text-base lg:text-lg leading-relaxed text-[#6e6e73]">
        The refund policy page that used to live here described a consumer subscription service that is not part of
        this catalogue. Warranty claims, dead-on-arrival units and returns for FMUSER equipment are covered on the
        Warranty and Returns page.
      </p>
      <a href="/warranty-returns/" class="btn-primary mt-8 text-base px-9 py-3.5">
        <i class="fas fa-arrow-right" aria-hidden="true"></i> Go to Warranty and Returns
      </a>
    </div>
  </section>
</Layout>
