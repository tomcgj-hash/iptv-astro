---
// ============================================================
// privacy.astro - privacy policy for a B2B equipment website
// Rewritten 2026-09-14: the previous version was written for a consumer IPTV
// service. This one describes what the site actually does:
//   * the enquiry form posts to Web3Forms (third party) which delivers the email
//   * fonts, icons and the CSS framework load from public CDNs
//   * no analytics, no advertising or tracking cookies are used on this site
// ============================================================
import Layout from '../layouts/Layout.astro';

const SITE = 'https://www.iptv-demo.example.com';

const privacySchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Privacy Policy - FMUSER',
  url: `${SITE}/privacy/`,
  description:
    'How FMUSER handles the information you send through this website: the enquiry form, the third-party services used to deliver it, and your requests for access or deletion.',
};

const breadcrumbs = [{ name: 'Privacy Policy', url: '/privacy/' }];
---

<Layout
  title="Privacy Policy | FMUSER"
  description="What this website collects (the enquiry form), which third-party services deliver it, and how to ask us to correct or delete your information."
  schema={privacySchema}
  breadcrumbs={breadcrumbs}
>
  <section class="py-14 lg:py-20 bg-white" aria-label="Privacy policy">
    <div class="container mx-auto max-w-3xl px-4">
      <div class="policy-content">
        <h1>Privacy Policy</h1>
        <p><time datetime="2026-09-14">Last updated: September 14, 2026</time></p>
        <p>
          This policy explains what happens to the information you send to FMUSER through this website. It covers
          business enquiries about digital TV headend equipment — there is no customer account, subscription or
          payment on this site.
        </p>

        <h2>1. What we collect</h2>
        <ul>
          <li>
            <strong>Enquiry details you type in:</strong> your name, email address, company (if you give it), the
            subject you select and the message itself, including any model numbers or project details you include.
          </li>
          <li>
            <strong>Technical data from your browser request:</strong> like any web server, the hosting provider of
            this site may keep standard access records — IP address, browser type, pages requested and time — for
            security and troubleshooting.
          </li>
          <li><strong>What we do not collect:</strong> we do not ask for payment details on this site, and there is no account to register.</li>
        </ul>

        <h2>2. Why we use it</h2>
        <ul>
          <li>To answer your enquiry and prepare a quotation for the models you ask about.</li>
          <li>To keep a record of the technical details agreed for an order, so support and warranty questions can be handled later.</li>
          <li>To protect the site against spam and abusive form submissions.</li>
        </ul>

        <h2>3. Third-party services used by this site</h2>
        <p>Being specific about this is easier than a paragraph of generalities:</p>
        <ul>
          <li>
            <strong>Form delivery — Web3Forms.</strong> The contact and quote forms are submitted to
            <em>api.web3forms.com</em>, which relays the message to our mailbox. The content of your message passes
            through that service.
          </li>
          <li>
            <strong>Google Fonts</strong> (<em>fonts.googleapis.com</em>) supplies the typeface, and
            <strong>cdnjs / Cloudflare</strong> supplies the icon set used in the interface. Your browser requests
            those files directly, so those providers see your IP address as part of serving them.
          </li>
          <li>
            <strong>Tailwind CSS CDN</strong> serves the styling framework used to render the pages.
          </li>
        </ul>

        <h2>4. Cookies and analytics</h2>
        <p>
          We do not set advertising or tracking cookies on this site, and no analytics or advertising tag is
          installed here. If that changes, this page will say which service is used and what it collects.
        </p>

        <h2>5. How long we keep it</h2>
        <p>
          Enquiry correspondence is kept while it is relevant to the business relationship — for example while a
          quotation is open, or for as long as the order and warranty records need to be available. Ask us to delete
          your enquiry and we will remove it, unless we are required to keep a record for accounting or legal
          reasons.
        </p>

        <h2>6. Sharing</h2>
        <p>
          We do not sell or rent your information. It is shared only where it is needed to answer you: the form
          delivery service described above, our own mail provider, and — for a specific order — the freight forwarder
          or customs broker handling that shipment.
        </p>

        <h2>7. Security</h2>
        <p>
          The site is served over HTTPS and form submissions are encrypted in transit. Access to enquiry mail is
          limited to the people who prepare quotations and support the orders.
        </p>

        <h2>8. Your requests</h2>
        <p>
          Write to <a href="mailto:sales@fmuser.com">sales@fmuser.com</a> to ask what we hold about your enquiry, to
          correct it, or to have it deleted. Tell us the email address you used when you wrote to us so we can find
          the record.
        </p>

        <h2>9. Changes to this policy</h2>
        <p>
          If the way this site handles information changes — for example if we add an analytics service — this page
          is updated and the date at the top changes.
        </p>

        <h2>10. Contact</h2>
        <p>
          Privacy questions: <a href="mailto:sales@fmuser.com">sales@fmuser.com</a>. Technical or sales enquiries:
          use the <a href="/contact/">contact form</a>.
        </p>
      </div>
    </div>
  </section>
</Layout>
