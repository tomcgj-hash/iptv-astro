---
// 隐私政策页 — 按 privacy.md 规则：
// 页面简洁，作为模板，其他类似页面共用（只有标题和内容不一样）
// 内容由后台编辑，p/h 标签不带 class，样式统一定义在 css/style.css 的 .policy-content
import Layout from '../layouts/Layout.astro';

const privacySchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Privacy Policy — IPTVStream',
  url: 'https://www.iptv-demo.example.com/privacy/',
  description: 'Read the IPTVStream privacy policy to understand how we collect, use and protect your personal information.',
};

const breadcrumbs = [{ name: 'Privacy Policy', url: '/privacy/' }];
---

<Layout
  title="Privacy Policy | IPTVStream"
  description="Read the IPTVStream privacy policy: how we collect, use and protect your personal information when you use our broadcast equipment."
  schema={privacySchema}
  breadcrumbs={breadcrumbs}
>
  <section class="py-14 lg:py-20 bg-white" aria-label="Privacy policy">
    <div class="container mx-auto max-w-3xl px-4">
      <!-- 内容由后台编辑，不带 class，样式在 css/style.css -->
      <div class="policy-content">
        <h1>Privacy Policy</h1>
        <p><time datetime="2026-01-01">Last updated: January 1, 2026</time></p>
        <p>
          This Privacy Policy explains how IPTVStream ("we", "us" or "our") collects, uses, stores and protects
          your personal information when you visit our website or use our broadcast equipment manufacturing and sales.
        </p>

        <h2>1. Information We Collect</h2>
        <p>We collect the following types of information when you use our service:</p>
        <ul>
          <li><strong>Account information</strong> — your name, email address and payment details when you purchase a purchase order.</li>
          <li><strong>Device information</strong> — device type, operating system and app version to help us optimize your experience.</li>
          <li><strong>Usage data</strong> — pages you visit and how you interact with our website.</li>
          <li><strong>Communication data</strong> — messages you send to our support team.</li>
        </ul>

        <h2>2. How We Use Your Information</h2>
        <p>We use your information to:</p>
        <ul>
          <li>Provide, maintain and improve our broadcast equipment.</li>
          <li>Process your payments and manage your purchase order.</li>
          <li>Respond to your questions and provide customer support.</li>
          <li>Send you service updates and important notices.</li>
          <li>Prevent fraud and ensure the security of our service.</li>
        </ul>

        <h2>3. How We Protect Your Information</h2>
        <p>
          We take the security of your personal information seriously. We use industry-standard encryption
          (SSL/TLS) to protect data transmitted between your device and our servers. Payment information is
          processed by trusted third-party payment providers and is never stored on our servers in plain text.
        </p>

        <h2>4. Sharing Your Information</h2>
        <p>We do not sell, trade or rent your personal information to third parties. We may share your information only with:</p>
        <ul>
          <li>Service providers who help us operate our service (such as payment processors and hosting providers).</li>
          <li>Authorities, when required by law or to protect our legal rights.</li>
        </ul>

        <h2>5. Cookies</h2>
        <p>
          Our website uses cookies to improve your browsing experience, remember your preferences and understand
          how visitors use our site. You can disable cookies in your browser settings, but some features of the
          website may not function properly.
        </p>

        <h2>6. Your Rights</h2>
        <p>You have the right to:</p>
        <ul>
          <li>Access the personal information we hold about you.</li>
          <li>Request correction of inaccurate information.</li>
          <li>Request deletion of your personal information.</li>
          <li>Withdraw consent for marketing communications at any time.</li>
        </ul>

        <h2>7. Children's Privacy</h2>
        <p>
          Our service is not directed to children under the age of 18. We do not knowingly collect personal
          information from children. If you believe a child has provided us with personal information, please
          contact us and we will delete it.
        </p>

        <h2>8. Changes to This Policy</h2>
        <p>
          We may update this Privacy Policy from time to time. We will notify you of any significant changes by
          posting the new policy on this page with an updated revision date.
        </p>

        <h2>9. Contact Us</h2>
        <p>
          If you have any questions about this Privacy Policy, please contact us at
          <a href="mailto:sales@coaxtoiptv.com">sales@coaxtoiptv.com</a>.
        </p>
      </div>
    </div>
  </section>
</Layout>
